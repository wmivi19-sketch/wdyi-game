extends RefCounted
## Original 16 × 16 indexed sprites. Index zero is transparent.
const PALETTE = ["00000000", "182b28", "395b42", "77aa59", "cee09a", "f4e6bd", "9b7145", "593e32", "bd5246", "f39753", "e8c45e", "497887", "83c9ca", "d6eff0", "847391", "393c57"]
const SPRITES = {
 "hero": ["0000003330000000","0000033333000000","0000333333300000","0000035553000000","0000051555000000","0000055555000000","0000006600000000","0000033333000000","0005333333500000","0005334333500000","0000033333000000","0000066666000000","0000060066000000","0000060066000000","0000770077000000","0000000000000000"],
 "sword": ["0000000000000dd0","000000000000dd00","00000000000dd000","0000000000dd0000","000000000dd00000","00000000dd000000","0000000dd0000000","000900dd00000000","000099d000000000","0000099000000000","0000069900000000","0000660900000000","0006600000000000","0066000000000000","0000000000000000","0000000000000000"],
 "herb": ["0000000000000000","0000003300000000","0000003430000000","0000003430000000","0033003300330000","0034303303430000","0003433334300000","0000333333000000","0000003300000000","0000003300000000","0000003300000000","0000006600000000","0000066600000000","0000000000000000","0000000000000000","0000000000000000"],
 "potion": ["0000000000000000","0000066660000000","0000066660000000","00000dddd0000000","00000d00d0000000","0000dd00dd000000","000dd8888dd00000","000d898888d00000","000d898888d00000","000d888888d00000","000d888888d00000","000dd8888dd00000","0000dddddd000000","0000000000000000","0000000000000000","0000000000000000"],
 "ore": ["0000000000000000","000000ccc0000000","00000cdddc000000","0000cdddccc00000","000cdddccbbc0000","00cdddccbbbbc000","00cddccbbbbbc000","00ccccbbbbbbc000","00cbbbbbbbbbc000","000cbbbbbbbc0000","0000ccccccc00000","0000000000000000","0000000000000000","0000000000000000","0000000000000000","0000000000000000"]
}
static func texture(kind: String) -> ImageTexture:
 var img := Image.create(16, 16, false, Image.FORMAT_RGBA8)
 var rows: Array = SPRITES.get(kind, SPRITES.hero)
 for y in 16:
  for x in 16:
   var index := "0123456789abcdef".find(rows[y][x])
   img.set_pixel(x, y, Color(PALETTE[index]))
 return ImageTexture.create_from_image(img)
