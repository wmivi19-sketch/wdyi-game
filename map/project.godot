TradeManager="*res://shop-and-object/scripts/trading/trade_manager.gd"
GameManager="*res://scripts/GameManager.gd"
ClassManager="*res://progression/systems/class_manager.gd"
ProfessionDatabase="*res://scripts/professions/profession_database.gd"
MapDatabase="*res://scripts/data/map_database.gd"
GameSession="*res://scripts/game/game_session.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=740

