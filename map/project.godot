; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="逐神终焉"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]


Config="*res://shop-and-object/scripts/utils/config.gd"
AssetManager="*res://shop-and-object/scripts/utils/asset_manager.gd"
ItemDatabase="*res://shop-and-object/scripts/items/item_database.gd"
GameState="*res://shop-and-object/scripts/game/game_state.gd"
CraftingSystem="*res://shop-and-object/scripts/crafting/crafting_system.gd"
TradeManager="*res://shop-and-object/scripts/trading/trade_manager.gd"

GameManager="*res://scripts/GameManager.gd"
ClassManager="*res://progression/systems/class_manager.gd"
ProfessionDatabase="*res://scripts/professions/profession_database.gd"
MapDatabase="*res://scripts/data/map_database.gd"
GameSession="*res://scripts/game/game_session.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=740
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
open_player_panel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194306), Object(InputEventKey,"physical_keycode":66)]
}

toggle_continent_map={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":89)]
}
toggle_local_map={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
